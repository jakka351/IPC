\r\r\n    \r\r\n    vec4 outColor = texture * highlight; \r\r\n    \r\r\n    float chapletArea = 0.0;\r\r\n    float chapletInnerOutEdge = Gauge_ChapletBorder.x;//0.619;\r\r\n    float chapletInnerInEdge = centerDist;\r\r\n    float chapletOuterOutEdge = 1.0-centerDist; \r\r\n    float chapletOuterInEdge = Gauge_ChapletBorder.y; //0.162;\r\r\n    \r\r\n    chapletArea = step(chapletInnerOutEdge\,chapletInnerInEdge);\r\r\n    chapletArea *= step(chapletOuterInEdge\,chapletOuterOutEdge);\r\r\n    chapletArea = step(baselength\,SweepLength.x) * reflectionSweep * (1.0-chapletArea);\r\r\n     float chapletBrightAdjust = 1.2;   \r\r\n    outColor = mix(outColor\,outColor*SweepColor*chapletBrightAdjust\,chapletArea);\r\r\n\r\r\n    outColor += sweeplen*cmTailSweep*SweepColor*SweepBrightness*sweepBrightAdjust;        \r\r\n\r\r\n    gl_FragColor = outColor;\r\r\n}\r\n\"","2631"
